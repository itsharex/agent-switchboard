<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{9E2C80FA-7F99-4696-826C-A94CDAF6B9A2}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AgentSwitchboard.Installer</RootNamespace>
    <AssemblyName>AgentSwitchboard.Installer</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <FileAlignment>512</FileAlignment>
    <LangVersion>5</LangVersion>
    <StartupObject>AgentSwitchboard.Installer.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\src-tauri\icons\icon.ico</ApplicationIcon>
    <OutputPath Condition=" '$(OutputPath)' == '' ">bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath Condition=" '$(IntermediateOutputPath)' == '' ">obj\$(Configuration)\</IntermediateOutputPath>
    <TargetName Condition=" '$(TargetName)' == '' ">$(AssemblyName)</TargetName>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <InstallerBuildInfoFile Condition=" '$(InstallerBuildInfoFile)' == '' ">$(IntermediateOutputPath)InstallerBuildInfo.cs</InstallerBuildInfoFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="InstallationRequest.cs" />
    <Compile Include="InstallerEngine.cs" />
    <Compile Include="InstallerFailure.cs" />
    <Compile Include="InstallerInvocation.cs" />
    <Compile Include="InstallerText.cs" />
    <Compile Include="InstallerWindow.cs" />
    <Compile Include="InstallerWindowLayout.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(InstallerBuildInfoFile)">
      <Link>Generated\InstallerBuildInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Include="Theme.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <EmbeddedResource Include="Theme.xaml">
      <LogicalName>AgentSwitchboard.Installer.Theme.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\installer-background.wdp">
      <LogicalName>AgentSwitchboard.Installer.Assets.InstallerBackground.wdp</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(InstallerEnginePath)" Condition=" '$(InstallerEnginePath)' != '' ">
      <LogicalName>AgentSwitchboard.Installer.Engine.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RequireInstallerInputs" BeforeTargets="PrepareForBuild">
    <Error
      Condition=" '$(InstallerEnginePath)' == '' Or !Exists('$(InstallerEnginePath)') "
      Text="InstallerEnginePath must point to the Tauri NSIS engine." />
    <Error
      Condition=" !Exists('$(InstallerBuildInfoFile)') "
      Text="InstallerBuildInfoFile must be generated by scripts/build-windows-installer.ps1." />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
