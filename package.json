{
  "name": "agent-switchboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASB_WEB_DEVELOPMENT=1 tauri dev",
    "dev:desktop": "cross-env ASB_WEB_DEVELOPMENT= CARGO_TARGET_DIR=target-dev tauri dev",
    "dev:frontend": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:updater-release": "node --test scripts/updater-release.test.mjs",
    "build:e2e:desktop": "pwsh -NoProfile -File scripts/build-e2e-desktop.ps1",
    "test:e2e:desktop": "node e2e/run-desktop-e2e.mjs",
    "test:e2e:release": "node e2e/run-desktop-e2e.mjs --release",
    "tauri": "tauri",
    "tauri:build:windows": "pwsh -NoProfile -File scripts/build-windows-installer.ps1",
    "msix:package": "pwsh -NoProfile -File scripts/package-msix.ps1 -ExecutablePath target/release/agent-switchboard.exe -WebView2LoaderPath target/release/WebView2Loader.dll",
    "msix:build": "npm run tauri:build:windows && npm run msix:package",
    "tauri:build:macos": "tauri build --config src-tauri/tauri.macos.conf.json",
    "tauri:build:linux": "tauri build --config src-tauri/tauri.linux.conf.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.41.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.259",
    "@iarna/toml": "2.2.5",
    "@openai/codex": "0.152.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wdio/cli": "9.31.6",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.6",
    "@wdio/mocha-framework": "9.31.6",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.4.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "webdriverio": "9.31.6"
  }
}
